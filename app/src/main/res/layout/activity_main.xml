<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout otimizado para a tela do Microwear Ultra AI 3 (~2.06" / 466x466 px).
  - Radar ocupa praticamente toda a área visível.
  - Stats sobrepostos (overlay) no topo e rodapé para não roubar espaço.
  - Toque em qualquer ponto força um novo scan.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <com.wifiradar.app.RadarView
        android:id="@+id/radar_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/txt_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="6dp"
        android:textColor="#FF00FF88"
        android:textSize="11sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowRadius="2"
        android:text="@string/scanning" />

    <TextView
        android:id="@+id/txt_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:textColor="#FFAAAAAA"
        android:textSize="10sp"
        android:shadowColor="#000000"
        android:shadowRadius="2"
        android:text="@string/count_default" />

</FrameLayout>
